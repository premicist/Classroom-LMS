<?xml version="1.0" encoding="utf-8"?>
<!--
   Classroom-LMS Backup Rules
   Explicitly excludes Room Database and exported sensitive reports from auto-backup.
-->
<full-backup-content>
    <exclude domain="database" path="classroom_lms_db"/>
    <exclude domain="database" path="classroom_lms_db-journal"/>
    <exclude domain="database" path="classroom_lms_db-shm"/>
    <exclude domain="database" path="classroom_lms_db-wal"/>
    <exclude domain="file" path="reports"/>
    <exclude domain="file" path="exports"/>
</full-backup-content>
